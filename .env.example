# Database
DATABASE_URL=postgresql+asyncpg://loom:loom@localhost:5432/loom
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Environment
ENVIRONMENT=development
# Required when ENVIRONMENT is not development. Use a long random value and
# share it only with operators who are allowed to run `loom init`.
BOOTSTRAP_TOKEN=
# Compatibility only for credentials issued before opaque loom_ keys.
# Keep false for a new installation and for production.
ALLOW_LEGACY_UUID_TOKENS=false
ALLOW_AGENT_KEY_ENROLLMENT=false
PUBLIC_SIGNUPS_ENABLED=true
USER_SESSION_TTL_DAYS=30
AGENT_KEY_TTL_DAYS=90
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Embedding Provider (stub | openai | local)
EMBEDDING_PROVIDER=stub
OPENAI_API_KEY=

# Summarization (stub | groq)
SUMMARIZATION_PROVIDER=stub
SUMMARIZATION_INTERVAL_MINUTES=15
SUMMARIZATION_WINDOW_MINUTES=10
SUMMARIZATION_MAX_UNITS_PER_GROUP=50
SUMMARIZATION_MIN_UNITS=5

# Groq (for agent LLM calls — free tier, no credit card needed)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Observability (optional)
OTEL_ENDPOINT=
