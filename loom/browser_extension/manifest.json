{
  "manifest_version": 3,
  "name": "Loom — Context Bridge",
  "version": "0.2.2",
  "description": "Sync AI conversations into project-scoped Loom context for Claude Code, Codex, and other MCP clients.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://www.perplexity.ai/*",
    "http://localhost:8000/*",
    "https://loom-api-zzy0.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loom — Context Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
